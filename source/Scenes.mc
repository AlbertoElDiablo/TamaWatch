import Toybox.Lang;
import Toybox.WatchUi;

module Scenes {

    // Biome per dex number 1-151 (0 meadow, 1 beach, 2 forest, 3 volcano,
    // 4 mountain, 5 snow, 6 graveyard), as TamaPoke assigns them by primary type.
    const BIOMES = "2223331112222220000000000044000000003300002222222440011003311100000022211444331100000110011666400110022440000044020111111025032011100103011114050311100";

    function biomeFor(dex) {
        if (dex < 1 || dex > 151) { return 0; }   // eggs live in the meadow
        return BIOMES.substring(dex - 1, dex).toNumber();
    }

    // Same hours as TamaPoke: night before 6 and from 20, sunrise before 8, sunset from 18.
    function timeSlot(hour) {
        if (hour < 6 || hour >= 20) { return 3; }
        if (hour < 8) { return 0; }
        if (hour < 18) { return 1; }
        return 2;
    }

    function background(biome, slot) {
        var ids = [
            Rez.Drawables.bg0_dawn, Rez.Drawables.bg0_day, Rez.Drawables.bg0_dusk, Rez.Drawables.bg0_night,
            Rez.Drawables.bg1_dawn, Rez.Drawables.bg1_day, Rez.Drawables.bg1_dusk, Rez.Drawables.bg1_night,
            Rez.Drawables.bg2_dawn, Rez.Drawables.bg2_day, Rez.Drawables.bg2_dusk, Rez.Drawables.bg2_night,
            Rez.Drawables.bg3_dawn, Rez.Drawables.bg3_day, Rez.Drawables.bg3_dusk, Rez.Drawables.bg3_night,
            Rez.Drawables.bg4_dawn, Rez.Drawables.bg4_day, Rez.Drawables.bg4_dusk, Rez.Drawables.bg4_night,
            Rez.Drawables.bg5_dawn, Rez.Drawables.bg5_day, Rez.Drawables.bg5_dusk, Rez.Drawables.bg5_night,
            Rez.Drawables.bg6_dawn, Rez.Drawables.bg6_day, Rez.Drawables.bg6_dusk, Rez.Drawables.bg6_night,
        ];
        return ids[biome * 4 + slot];
    }
}
